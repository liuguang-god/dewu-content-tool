<% 
  // 错误页或未传参的 include 不会带 activeNav，避免 ReferenceError
  var _activeNav = typeof activeNav !== 'undefined' && activeNav ? activeNav : '';
%>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>得物种草工具</title>
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <header class="header">
    <div class="header-inner">
      <a href="/" class="logo">
        <div class="logo-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/>
          </svg>
        </div>
        得物种草工具
      </a>

      <nav class="header-nav" aria-label="主导航">
        <a href="/" class="nav-link <%= _activeNav === 'list' ? 'active' : '' %>">商品列表</a>
        <a href="<%= typeof product !== 'undefined' && product && product.id ? '/' + product.id : '#' %>"
           class="nav-link <%= _activeNav === 'product' ? 'active' : '' %>"
           <%= typeof product !== 'undefined' && product && product.id ? '' : 'aria-disabled=\"true\" tabindex=\"-1\"' %>>
          商品详情
        </a>
        <a href="<%= typeof contentId !== 'undefined' && contentId ? '/preview/' + contentId : '/preview' %>"
           class="nav-link <%= _activeNav === 'preview' ? 'active' : '' %>">
          内容预览
        </a>
        <a href="<%= typeof contentId !== 'undefined' && contentId ? '/export/' + contentId : '/export' %>"
           class="nav-link <%= _activeNav === 'export' ? 'active' : '' %>">
          导出中心
        </a>
      </nav>

      <div class="header-actions">
        <% if (_activeNav === 'list') { %>
          <button class="btn" id="scrapeBtn" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.65 6.35A7.958 7.958 0 0012 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0112 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>
            抓取新商品
          </button>
        <% } %>
      </div>
    </div>
  </header>
