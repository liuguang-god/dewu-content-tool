<%- include('partials/header', { activeNav: 'list' }) %>

<div class="layout">
  <aside class="sidebar">
    <div class="sidebar-section">
      <div class="sidebar-label">筛选品类</div>
      <a class="filter-item <%= !currentCategory ? 'active' : '' %>" href="/">
        全部商品
        <span class="filter-count"><%= typeof totalAllProducts !== 'undefined' ? totalAllProducts : (total || 0) %></span>
      </a>
      <% categories.forEach(function(cat) { %>
        <a class="filter-item <%= currentCategory === cat.key ? 'active' : '' %>" href="/?category=<%= cat.key %><%= currentStatus ? '&status=' + currentStatus : '' %>">
          <%= cat.label %>
          <span class="filter-count"><%= categoryCounts[cat.key] || 0 %></span>
        </a>
      <% }) %>
    </div>

    <hr class="sidebar-divider">

    <div class="sidebar-section">
      <div class="sidebar-label">内容状态</div>
      <a class="filter-item <%= !currentStatus ? 'active' : '' %>" href="<%= currentCategory ? '/?category=' + currentCategory : '/' %>">
        全部
        <span class="filter-count"><%= typeof countStatusAll !== 'undefined' ? countStatusAll : 0 %></span>
      </a>
      <a class="filter-item <%= currentStatus === 'pending' ? 'active' : '' %>"
         href="/?<%= currentCategory ? 'category=' + currentCategory + '&' : '' %>status=pending">
        未处理
        <span class="filter-count"><%= typeof countPending !== 'undefined' ? countPending : 0 %></span>
      </a>
      <a class="filter-item <%= currentStatus === 'processed' ? 'active' : '' %>"
         href="/?<%= currentCategory ? 'category=' + currentCategory + '&' : '' %>status=processed">
        已生成
        <span class="filter-count"><%= typeof countProcessed !== 'undefined' ? countProcessed : 0 %></span>
      </a>
      <a class="filter-item <%= currentStatus === 'published' ? 'active' : '' %>"
         href="/?<%= currentCategory ? 'category=' + currentCategory + '&' : '' %>status=published">
        已发布
        <span class="filter-count"><%= typeof countPublished !== 'undefined' ? countPublished : 0 %></span>
      </a>
    </div>

    <hr class="sidebar-divider">

    <div class="sidebar-section">
      <div class="sidebar-label">来源频道</div>
      <a class="filter-item <%= !currentChannel ? 'active' : '' %>"
         href="/?<%= currentCategory ? 'category=' + currentCategory + '&' : '' %><%= currentStatus ? 'status=' + currentStatus + '&' : '' %>">
        全部
        <span class="filter-count"><%= typeof totalAllProducts !== 'undefined' ? totalAllProducts : (total || 0) %></span>
      </a>
      <a class="filter-item <%= currentChannel === '穿搭' ? 'active' : '' %>"
         href="/?sourceChannel=穿搭<%= currentCategory ? '&category=' + currentCategory : '' %><%= currentStatus ? '&status=' + currentStatus : '' %>">
        穿搭
        <span class="filter-count"><%= channelCounts['穿搭'] || 0 %></span>
      </a>
      <a class="filter-item <%= currentChannel === '潮玩' ? 'active' : '' %>"
         href="/?sourceChannel=潮玩<%= currentCategory ? '&category=' + currentCategory : '' %><%= currentStatus ? '&status=' + currentStatus : '' %>">
        潮玩
        <span class="filter-count"><%= channelCounts['潮玩'] || 0 %></span>
      </a>
    </div>

    <hr class="sidebar-divider">

    <div class="sidebar-section">
      <button class="scrape-btn" id="scrapeBtnEmpty" type="button">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.35 10.04A7.49 7.49 0 0012 4C9.11 4 6.6 5.64 5.35 8.04A5.994 5.994 0 000 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM19 18H6c-2.21 0-4-1.79-4-4s1.79-4 4-4h.71C7.37 7.69 9.48 6 12 6c3.04 0 5.5 2.46 5.5 5.5v.5H19c1.66 0 3 1.34 3 3s-1.34 3-3 3z"/></svg>
        抓取新商品（穿搭+潮玩）
      </button>

      <div class="scrape-panel" id="scrapePanel" style="display:none">
        <div class="scrape-panel-head">
          <span class="scrape-panel-title">
            <span class="spinner" id="scrapeSpinner"></span>
            <span id="scrapePanelTitle">抓取中</span>
          </span>
          <span class="scrape-panel-status running" id="scrapePanelStatus">运行中</span>
        </div>

        <div class="scrape-steps" id="scrapeSteps"></div>

        <div class="scrape-progress-bar">
          <div class="scrape-progress-track">
            <div class="scrape-progress-fill" id="scrapeProgressFill"></div>
          </div>
          <div class="scrape-progress-label">
            <span id="scrapeProgressStep">准备中...</span>
            <span id="scrapeProgressPercent">0%</span>
          </div>
        </div>

        <div class="scrape-console">
          <div class="scrape-console-head" id="scrapeConsoleToggle">
            <span class="scrape-console-title">运行日志</span>
            <span class="scrape-console-toggle" id="scrapeConsoleArrow">▲</span>
          </div>
          <div class="scrape-console-body" id="scrapeConsoleBody"></div>
        </div>
      </div>
    </div>

    <div class="sidebar-section" style="margin-top:auto">
      <div style="font-size:11px;color:var(--muted);padding:0 8px;line-height:1.6">
        共 <%= total || 0 %> 件商品
      </div>
    </div>
  </aside>

  <main class="main">
    <div class="main-header">
      <h1 class="main-title">商品列表</h1>
      <span class="main-meta">显示 <%= total || 0 %> 件商品</span>
    </div>

    <% if (!products || products.length === 0) { %>
      <div class="empty-state">
        <div class="empty-state-icon">🗂️</div>
        <h3>暂无商品</h3>
        <p>点击左侧“抓取新商品”开始获取热门商品</p>
      </div>
    <% } else { %>
      <div class="product-grid">
        <% products.forEach(function(p) { %>
          <div class="product-card-wrap">
            <label class="product-select" title="勾选种草">
              <input type="checkbox" class="product-checkbox" value="<%= p.id %>" data-name="<%= p.name %>">
              <span class="product-checkmark"></span>
            </label>
            <a class="product-card" href="/<%= p.id %>">
              <div class="product-image">
                <% if (p.local_image_path || p.image_url) { %>
                  <img src="<%= p.local_image_path || p.image_url %>"
                       alt="<%= p.name %>"
                       onerror="this.onerror=null;this.src='data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%22600%22%20height%3D%22600%22%20viewBox%3D%220%200%20600%20600%22%3E%3Crect%20width%3D%22600%22%20height%3D%22600%22%20fill%3D%22%23f2f4f7%22/%3E%3Cpath%20d%3D%22M170%20440h260c16%200%2030-14%2030-30V220c0-16-14-30-30-30H170c-16%200-30%2014-30%2030v190c0%2016%2014%2030%2030%2030z%22%20fill%3D%22%23d8dde6%22/%3E%3Cpath%20d%3D%22M210%20330l55-55%2035%2035%2060-60%2080%2080v55H210z%22%20fill%3D%22%23b7c0cf%22/%3E%3Ccircle%20cx%3D%22255%22%20cy%3D%22260%22%20r%3D%2224%22%20fill%3D%22%23b7c0cf%22/%3E%3Ctext%20x%3D%22300%22%20y%3D%22515%22%20text-anchor%3D%22middle%22%20font-family%3D%22Arial%2C%20sans-serif%22%20font-size%3D%2220%22%20fill%3D%22%236b7280%22%3EImage%20unavailable%3C/text%3E%3C/svg%3E'">
                <% } else { %>
                  <div class="placeholder"><%= categoryMap[p.category]?.icon || '🏷️' %></div>
                <% } %>

                <% if (p.source_channel) { %>
                  <span class="product-channel-badge"><%= p.source_channel %></span>
                <% } %>

                <% const catInfo = categoryMap[p.category]; %>
                <% if (catInfo) { %>
                  <span class="product-badge badge-<%= p.category %>"><%= catInfo.badge %></span>
                <% } %>

                <% if (p.status === 'pending') { %>
                  <span class="product-status status-pending" data-tooltip="未处理"></span>
                <% } else if (p.status === 'processed') { %>
                  <span class="product-status status-processed" data-tooltip="已生成内容"></span>
                <% } else if (p.status === 'published') { %>
                  <span class="product-status status-published" data-tooltip="已发布"></span>
                <% } %>
              </div>

              <div class="product-info">
                <div class="product-name"><%= p.name %></div>
                <div class="product-price-row">
                  <span class="product-price"><%= p.price ? ('¥' + p.price) : '价格待定' %></span>
                  <span class="product-unit"><%= p.price ? '券后价' : '' %></span>
                </div>
                <div class="product-hot">
                  <div class="hot-bar"><div class="hot-fill" style="width:<%= Math.min(100, Math.max(0, (Number(p.hot_score) || 0) / 15000 * 100)) %>%"></div></div>
                  <span class="hot-score">热度 <%= p.hot_score || 0 %></span>
                </div>
              </div>
            </a>
          </div>
        <% }) %>
      </div>

      <% if (products && products.length > 0) { %>
        <div class="seed-bar" id="seedBar" style="display:none">
          <span class="seed-bar-text">已选 <strong id="seedCount">0</strong> 个商品</span>
          <button class="seed-btn" id="seedBtn" disabled>种草已选</button>
        </div>
      <% } %>
    <% } %>
  </main>
</div>

<%- include('partials/footer') %>